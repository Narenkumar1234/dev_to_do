{
  "manifest_version": 3,
  "name": "Notes Tab - VizGo",
  "version": "1.0.0",
  "description": "A beautiful and productive new tab experience with task management, notes, and live clock",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "author": "Naren Kumar",
  "homepage_url": "https://github.com/Narenkumar1234/dev_to_do"
}